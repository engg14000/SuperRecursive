{
    "tool_calling_schemas": {
        "version": "1.0",
        "description": "JSON schemas for code execution tools",
        "tools": [
            {
                "name": "run_command",
                "description": "Execute a shell command",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "command": {
                            "type": "string",
                            "description": "Command to execute"
                        },
                        "cwd": {
                            "type": "string",
                            "description": "Working directory"
                        },
                        "timeout_ms": {
                            "type": "integer",
                            "default": 60000
                        },
                        "env": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "required": [
                        "command"
                    ]
                },
                "returns": {
                    "type": "object",
                    "properties": {
                        "exit_code": {
                            "type": "integer"
                        },
                        "stdout": {
                            "type": "string"
                        },
                        "stderr": {
                            "type": "string"
                        },
                        "elapsed_ms": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "name": "run_python",
                "description": "Execute Python code in an isolated environment",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "code": {
                            "type": "string",
                            "description": "Python code to execute"
                        },
                        "packages": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Pip packages to install first"
                        },
                        "timeout_ms": {
                            "type": "integer",
                            "default": 30000
                        }
                    },
                    "required": [
                        "code"
                    ]
                }
            },
            {
                "name": "run_tests",
                "description": "Run a test suite",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "framework": {
                            "type": "string",
                            "enum": [
                                "pytest",
                                "jest",
                                "mocha",
                                "junit",
                                "go-test",
                                "cargo-test"
                            ]
                        },
                        "path": {
                            "type": "string",
                            "description": "Test file or directory"
                        },
                        "filter": {
                            "type": "string",
                            "description": "Test name filter pattern"
                        },
                        "verbose": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "required": [
                        "framework"
                    ]
                }
            },
            {
                "name": "lint_code",
                "description": "Run linting and static analysis",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "tool": {
                            "type": "string",
                            "enum": [
                                "eslint",
                                "pylint",
                                "flake8",
                                "rubocop",
                                "golint",
                                "clippy"
                            ]
                        },
                        "path": {
                            "type": "string"
                        },
                        "fix": {
                            "type": "boolean",
                            "default": false,
                            "description": "Auto-fix issues"
                        }
                    },
                    "required": [
                        "tool",
                        "path"
                    ]
                }
            },
            {
                "name": "compile_code",
                "description": "Compile source code",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "language": {
                            "type": "string",
                            "enum": [
                                "typescript",
                                "rust",
                                "go",
                                "java",
                                "c",
                                "cpp"
                            ]
                        },
                        "source": {
                            "type": "string",
                            "description": "Source file or project directory"
                        },
                        "output": {
                            "type": "string",
                            "description": "Output file path"
                        },
                        "flags": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "required": [
                        "language",
                        "source"
                    ]
                }
            }
        ]
    }
}